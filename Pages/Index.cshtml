@page
@model IndexModel
@{ ViewData["Title"]="Home"; }
<section class="hero">
<p class="eyebrow">A small challenge for a sharp mind</p>
<h1>Can you reach the final gate?</h1>
<p class="intro">Four rooms. Four clues. One final code. Read carefully, solve each clue and keep an eye on your time.</p>
<div class="actions">
@if (HttpContext.Session.GetInt32("UserId") != null) {
<a class="button" asp-page="/Game">Start challenge</a>
} else {
<a class="button" asp-page="/Account/Register">Create player account</a>
<a class="button secondary" asp-page="/Account/Login">I already have an account</a>
}
</div>
</section>
<section class="cards">
<article><h3>4 rooms</h3><p>Each room uses a different clue style.</p></article>
<article><h3>Timed attempt</h3><p>Completion time becomes part of the result.</p></article>
<article><h3>Scoreboard</h3><p>Completed attempts can be compared.</p></article>
</section>